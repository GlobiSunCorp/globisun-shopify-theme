{"sections":{"collection_top":{"type":"custom-liquid","settings":{"custom_liquid":"<section class='gs-collection-top'><style>.gs-collection-top{max-width:1200px;margin:0 auto;padding:48px 20px 18px}.gs-collection-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:36px}.gs-collection-brand{display:inline-flex;align-items:center;gap:10px;color:#364247;text-decoration:none;font-weight:900}.gs-collection-brand span:first-child{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:999px;background:#364247;color:#fff;font-size:13px}.gs-collection-menu{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.gs-collection-menu a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 18px;border-radius:999px;text-decoration:none;font-weight:900;color:#364247;border:1px solid rgba(54,66,71,.18);background:#fff}.gs-collection-menu a.gs-primary{background:#364247;color:#fff}.gs-collection-kicker{margin:0 0 12px;text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:900;color:#6f7a7d}.gs-collection-title{margin:0;color:#364247;font-size:clamp(42px,6vw,76px);line-height:.98;letter-spacing:-.045em}.gs-collection-copy{max-width:760px;margin:22px 0 0;color:#667074;font-size:17px;line-height:1.6}.gs-search-panel{margin-top:26px;border:1px solid rgba(54,66,71,.13);border-radius:24px;background:linear-gradient(135deg,#fff,#f7fbff);padding:18px;box-shadow:0 18px 46px rgba(24,33,38,.06)}.gs-search-form{display:flex;gap:12px;align-items:center}.gs-search-form input{flex:1;border:1px solid rgba(54,66,71,.18);border-radius:16px;min-height:56px;padding:0 18px;font:inherit;color:#364247;background:#fff}.gs-search-form button{border:0;border-radius:16px;min-height:56px;padding:0 24px;background:#2f6fbd;color:#fff;font-weight:900;box-shadow:0 14px 32px rgba(47,111,189,.22);cursor:pointer}.gs-quick-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.g