{"sections":{"collection_top":{"type":"custom-liquid","settings":{"custom_liquid":"<section class='gs-collection-top'><style>.gs-collection-top{max-width:1200px;margin:0 auto;padding:48px 20px 18px}.gs-collection-kicker{margin:0 0 12px;text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:900;color:#6f7a7d}.gs-collection-title{margin:0;color:#364247;font-size:clamp(42px,6vw,76px);line-height:.98;letter-spacing:-.045em}.gs-collection-copy{max-width:760px;margin:22px 0 0;color:#667074;font-size:17px;line-height:1.6}.gs-search-panel{margin-top:26px;border:1px solid rgba(54,66,71,.13);border-radius:24px;background:linear-gradient(135deg,#fff,#f7fbff);padding:18px;box-shadow:0 18px 46px rgba(24,33,38,.06)}.gs-search-form{display:flex;gap:12px;align-items:center}.gs-search-form input{flex:1;border:1px solid rgba(54,66,71,.18);border-radius:16px;min-height:56px;padding:0 18px;font:inherit;color:#364247;background:#fff}.gs-search-form button{border:0;border-radius:16px;min-height:56px;padding:0 24px;background:#2f6fbd;color:#fff;font-weight:900;box-shadow:0 14px 32px rgba(47,111,189,.22);cursor:pointer}.gs-quick-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.gs-quick-tags a{display:inline-flex;padding:9px 12px;border-radius:999px;background:#eef5ff;color:#2f6fbd;text-decoration:none;font-size:13px;font-weight:900}.gs-cat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:28px}.gs-cat-card{position:relative;min-height:128px;border:1px solid rgba(54,66,71,.13);border-radius:22px;background:#fff;text-decoration:none;color:#364247;padding:18px;box-shadow:0 12px 30px rgba(24,33,38,.05);transition:.18s ease;overflow:hidden}.gs-cat-card:hover{transform:translateY(-3px);border-color:rgba(47,111,189,.45);box-shadow:0 20px 42px rgba(47,111,189,.12)}.gs-cat-card small{display:block;text-transform:uppercase;letter-spacing:.16em;font-size:10px;font-weight:900;color:#6f7a7d;margin-bottom:10px}.gs-cat-card strong{display:block;font-size:20px;line-height:1.1;letter-spacing:-.025em}.gs-cat-card p{margin:10px 0 0;color:#667074;font-size:13px;line-height:1.35}.gs-cat-card:after{content:'→';position:absolute;right:18px;bottom:14px;color:#2f6fbd;font-size:20px;font-weight:900}.gs-filter-hint{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,360px);gap:16px;align-items:stretch;margin:28px 0 0}.gs-filter-note,.gs-bulk-help{border-radius:18px;padding:18px;background:#f7f6f3;color:#667074;line-height:1.55}.gs-filter-note strong,.gs-bulk-help strong{color:#364247}.gs-bulk-help{background:linear-gradient(135deg,#eef5ff,#fff);border:1px solid rgba(47,111,189,.16)}.gs-bulk-help p{margin:6px 0 14px}.gs-bulk-help a{display:inline-flex;align-items:center;justify-content:center;padding:11px 15px;border-radius:999px;background:#2f6fbd;color:#fff;font-weight:900;text-decoration:none;box-shadow:0 10px 24px rgba(47,111,189,.18)}@media(max-width:900px){.gs-cat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.gs-search-form{flex-direction:column}.gs-search-form input,.gs-search-form button{width:100%}.gs-filter-hint{grid-template-columns:1fr}}@media(max-width:560px){.gs-cat-grid{grid-template-columns:1fr}.gs-collection-title{font-size:44px}}</style><p class='gs-collection-kicker'>Wholesale Catalog</p><h1 class='gs-collection-title'>{% if collection.title != blank %}{{ collection.title }}{% else %}All Products{% endif %}</h1><p class='gs-collection-copy'>Browse products as catalog references. Use product names, expected quantity, destination ZIP code, and timeline when requesting bulk pricing.</p><div class='gs-search-panel'><form class='gs-search-form' action='{{ routes.search_url }}' method='get' role='search'><input type='hidden' name='type' value='product'><input type='search' name='q' placeholder='Search products: acrylic paint, markers, apron, storage box, glue...' aria-label='Search products'><button type='submit'>Search Products</button></form><div class='gs-quick-tags'><a href='/search?q=acrylic%20paint&type=product'>Acrylic paint</a><a href='/search?q=marker&type=product'>Markers</a><a href='/search?q=apron&type=product'>Aprons</a><a href='/search?q=storage&type=product'>Storage</a><a href='/search?q=glue&type=product'>Glue</a><a href='/search?q=canvas%20paper&type=product'>Canvas / Paper</a></div></div><div class='gs-cat-grid'><a class='gs-cat-card' href='/collections/all'><small>01 Catalog</small><strong>All Products</strong><p>Complete current product list for bulk quote references.</p></a><a class='gs-cat-card' href='/collections/acrylic-paints'><small>02 Painting</small><strong>Painting Supplies</strong><p>Acrylic paints, color sets, and classroom painting materials.</p></a><a class='gs-cat-card' href='/collections/acrylic-markers'><small>03 Drawing</small><strong>Drawing & Illustration</strong><p>Markers, drawing pens, and daily creative tools.</p></a><a class='gs-cat-card' href='/collections/alcohol-marker-pens'><small>04 Markers</small><strong>Alcohol Markers</strong><p>Marker sets and illustration supply options.</p></a></div><div class='gs-filter-hint'><div class='gs-filter-note'><strong>Filter & Sort:</strong> use the product grid controls below to narrow results by availability, price, and product options when available.</div><div class='gs-bulk-help'><strong>Need more than the catalog?</strong><p>If you cannot find the exact item, need larger quantities, logo printing, custom kits, or sourcing help, send us a bulk inquiry.</p><a href='/#bulk-inquiry'>Open Bulk Inquiry →</a></div></div></section>","color_scheme":"scheme-1","padding_top":0,"padding_bottom":0}},"main-collection-product-grid":{"type":"main-collection-product-grid","settings":{"products_per_page":36,"columns_desktop":4,"columns_mobile":"2","color_scheme":"scheme-1","image_ratio":"square","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"quick_add":"standard","enable_filtering":true,"filter_type":"horizontal","enable_sorting":true}}},"order":["collection_top","main-collection-product-grid"]}