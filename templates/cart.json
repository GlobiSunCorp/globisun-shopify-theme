{"sections":{"main":{"type":"globisun-order-builder-cart","settings":{"color_scheme":"scheme-1"}},"prepared_order_share":{"type":"custom-liquid","settings":{"custom_liquid":"{% if cart.item_count > 0 %}<section class='gs-prepared-share'><style>.gs-prepared-share{width:min(1180px,calc(100% - 32px));margin:-48px auto 80px}.gs-prepared-share__box{border:1px solid rgba(47,111,189,.18);border-radius:24px;background:linear-gradient(135deg,#eef5ff,#fff);padding:22px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center}.gs-prepared-share h2{margin:0;color:#364247;font-size:24px}.gs-prepared-share p{margin:7px 0 0;color:#667074;line-height:1.5}.gs-prepared-share button{border:0;border-radius:14px;background:#2f6fbd;color:#fff;min-height:52px;padding:0 20px;font-weight:900;cursor:pointer;box-shadow:0 12px 28px rgba(47,111,189,.2)}.gs-prepared-share__result{grid-column:1/-1;display:none}.gs-prepared-share__result.is-visible{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px}.gs-prepared-share__result input{width:100%;border:1px solid rgba(54,66,71,.2);border-radius:12px;background:#fff;padding:12px 13px;color:#364247}.gs-prepared-share__result button{min-height:46px}@media(max-width:700px){.gs-prepared-share__box,.gs-prepared-share__result.is-visible{grid-template-columns:1fr}.gs-prepared-share button{width:100%}}</style><div><h2>Create a prepared order link</h2><p>Copy a customer-editable link containing the current products and quantities. The customer opens it in the storefront cart, changes quantities, adds notes, and checks out after reaching $500.</p></div><button type='button' data-gs-build-prepared>Generate Share Link</button><div class='gs-prepared-share__result' data-gs-share-result><input type='text' readonly data-gs-share-url aria-label='Prepared order share link'><button type='button' data-gs-copy-prepared>Copy Link</button></div></div><script>(function(){var items=[{% for item in cart.items %}{id:{{ item.variant_id | json }},quantity:{{ item.quantity | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}];var root=document.currentScript.closest('.gs-prepared-share');if(!root)return;var build=root.querySelector('[data-gs-build-prepared]');var result=root.querySelector('[data-gs-share-result]');var input=root.querySelector('[data-gs-share-url]');var copy=root.querySelector('[data-gs-copy-prepared]');function makeLink(){var path=items.map(function(item){return item.id+':'+item.quantity;}).join(',');var params=new URLSearchParams();params.set('storefront','true');params.set('ref','prepared-order');var note=document.querySelector('#CartNote');if(note&&note.value.trim())params.set('note',note.value.trim());return window.location.origin+'/cart/'+path+'?'+params.toString();}build.addEventListener('click',function(){input.value=makeLink();result.classList.add('is-visible');input.focus();input.select();});copy.addEventListener('click',function(){if(!input.value)input.value=makeLink();if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(input.value).then(function(){copy.textContent='Copied ✓';setTimeout(function(){copy.textContent='Copy Link';},1600);});}else{input.focus();input.select();document.execCommand('copy');copy.textContent='Copied ✓';}});})();</script></section>{% endif %}","color_scheme":"scheme-1","padding_top":0,"padding_bottom":0}}},"order":["main","prepared_order_share"]}