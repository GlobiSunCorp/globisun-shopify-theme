<section class="globisun-home color-{{ section.settings.color_scheme }} gradient">
  <style>
    .globisun-home .globisun-proofline a{border:1px solid rgba(var(--color-foreground),.13);border-radius:999px;padding:.72rem 1.25rem;font-size:1.24rem;color:rgba(var(--color-foreground),.76);background:rgba(var(--color-background),.66);text-decoration:none}.globisun-home .globisun-steps>a{border:1px solid rgba(var(--color-foreground),.13);border-radius:22px;padding:2rem;display:grid;grid-template-columns:4.2rem 1fr;column-gap:1.4rem;align-items:start;background:rgba(var(--color-background),.82);text-decoration:none;color:inherit}.globisun-home .globisun-steps>a span{width:4.2rem;height:4.2rem;border-radius:999px;display:grid;place-items:center;background:rgba(var(--color-foreground),.08);font-weight:900}.globisun-home .globisun-steps>a strong{font-size:1.7rem;line-height:1.25}.globisun-home .globisun-steps>a p{grid-column:2;margin:.35rem 0 0;font-size:1.4rem}.globisun-home .gs-home-primary{display:inline-flex;align-items:center;justify-content:center;min-height:62px;padding:0 34px;border-radius:14px;background:#c94a3a;color:#fff;text-decoration:none;font-weight:900;letter-spacing:.03em;font-size:15px;box-shadow:0 16px 36px rgba(201,74,58,.28);border:1px solid rgba(120,30,20,.18)}.globisun-home .gs-home-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:62px;padding:0 34px;border-radius:14px;background:#2f6fbd;color:#fff;text-decoration:none;font-weight:900;letter-spacing:.03em;font-size:15px;box-shadow:0 16px 36px rgba(47,111,189,.24);border:1px solid rgba(28,78,138,.2)}@media(max-width:749px){.globisun-home .globisun-steps>a{grid-template-columns:3.8rem 1fr}.globisun-home .globisun-steps>a p{grid-column:1/-1}.globisun-home .gs-home-primary,.globisun-home .gs-home-secondary{width:100%}}
  </style>

  <div class="globisun-wrap">
    <div class="globisun-hero">
      <div class="globisun-hero__content">
        <p class="globisun-eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p class="globisun-lead">{{ section.settings.subheading }}</p>

        <div class="globisun-actions" style="align-items:center;gap:14px;flex-wrap:wrap;">
          <a class="gs-home-primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }} →</a>
          <a class="gs-home-secondary" href="{{ section.settings.secondary_link | default: routes.cart_url }}">{{ section.settings.secondary_label }}</a>
        </div>

        <p class="globisun-hero__microcopy">Fixed listed prices, live inventory, customer-editable quantities and notes, and one clear $500 wholesale minimum.</p>
        <div class="globisun-proofline globisun-proofline--v8" aria-label="Wholesale purchasing highlights">
          <a href="{{ routes.cart_url }}">$500 minimum</a>
          <a href="{{ routes.cart_url }}">Free U.S. shipping</a>
          <a href="{{ routes.cart_url }}">Sales tax included</a>
          <a href="{{ routes.cart_url }}">Editable order notes</a>
          <a href="/#bulk-inquiry">Configuration support</a>
        </div>
      </div>

      <aside class="globisun-hero__panel" aria-label="Wholesale order overview">
        <div class="globisun-panel-card globisun-panel-card--large">
          <span class="globisun-panel-label">Build the order your way</span>
          <strong>Choose products, set quantities, add customer instructions, and revise the order before checkout.</strong>
        </div>
        <div class="globisun-mini-grid">
          <a class="globisun-panel-card" href="/collections/all" style="text-decoration:none;color:inherit;"><span>01</span><strong>Browse live products</strong></a>
          <a class="globisun-panel-card" href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit;"><span>02</span><strong>Build the order</strong></a>
          <a class="globisun-panel-card" href="/#bulk-inquiry" style="text-decoration:none;color:inherit;"><span>03</span><strong>Request adjustments</strong></a>
          <a class="globisun-panel-card" href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit;"><span>04</span><strong>Confirm & checkout</strong></a>
        </div>
        <div class="globisun-metrics globisun-metrics--v8" aria-label="Wholesale purchase rules">
          <a class="globisun-metric" href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit;"><strong>$500</strong><span>required order minimum</span></a>
          <a class="globisun-metric" href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit;"><strong>$0</strong><span>standard U.S. shipping</span></a>
          <a class="globisun-metric" href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit;"><strong>Fixed</strong><span>all-in listed pricing</span></a>
        </div>
      </aside>
    </div>

    <div class="globisun-section-head">
      <p class="globisun-eyebrow">Who we serve</p>
      <h2>Built for organizations that need products—not a complicated purchasing process.</h2>
      <p>Schools, studios, camps, workshops, retailers, and creative teams can order stocked products directly or request help configuring a larger program order.</p>
    </div>

    <div class="globisun-card-grid globisun-card-grid--four">
      <a class="globisun-card globisun-card--link" href="/collections/all"><span class="globisun-card__label">Education</span><h3>Schools & Programs</h3><p>Classroom materials, student packs, camp supplies, and practical tools for structured learning.</p></a>
      <a class="globisun-card globisun-card--link" href="/collections/all"><span class="globisun-card__label">Studio</span><h3>Studios & Workshops</h3><p>Flexible quantities and product combinations for instructors, studios, and recurring sessions.</p></a>
      <a class="globisun-card globisun-card--link" href="/collections/all"><span class="globisun-card__label">Resale</span><h3>Retailers & Resellers</h3><p>Live catalog products with fixed pricing, inventory, variants, and editable quantities.</p></a>
      <a class="globisun-card globisun-card--link" href="/#bulk-inquiry"><span class="globisun-card__label">Custom</span><h3>Program & Brand Needs</h3><p>Color mixes, logo notes, packaging requests, kit planning, and substitute preferences.</p></a>
    </div>

    <div class="globisun-band" aria-label="Wholesale value points">
      <div class="globisun-band__grid">
        <a class="globisun-band__item" href="/collections/all" style="text-decoration:none;color:inherit;"><strong>Real inventory</strong><span>Buy currently available products and variants.</span></a>
        <a class="globisun-band__item" href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit;"><strong>Order-level control</strong><span>Adjust quantities and add product or order notes.</span></a>
        <a class="globisun-band__item" href="/#bulk-inquiry" style="text-decoration:none;color:inherit;"><strong>Configuration support</strong><span>Ask for help without opening a discount negotiation.</span></a>
        <a class="globisun-band__item" href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit;"><strong>All-in simplicity</strong><span>Free U.S. shipping and applicable sales tax included.</span></a>
      </div>
    </div>

    <div class="globisun-split">
      <div>
        <p class="globisun-eyebrow">How it works</p>
        <h2>A direct purchase flow with room for customer adjustments.</h2>
        <p>Start with stocked products and fixed prices. Add item-level requirements, revise quantities in the Order Builder, and request configuration help only when the order needs additional planning.</p>
        <div class="globisun-resource-strip">
          <a href="/collections/all">Product catalog</a>
          <a href="{{ routes.cart_url }}">Order Builder</a>
          <a href="/#bulk-inquiry">Configuration review</a>
        </div>
      </div>
      <div class="globisun-steps">
        <a href="/collections/all"><span>1</span><strong>Choose stocked products</strong><p>Review photos, variants, fixed pricing, and availability.</p></a>
        <a href="{{ routes.cart_url }}"><span>2</span><strong>Set quantities and notes</strong><p>Add colors, packaging, logo, deadline, and substitution instructions.</p></a>
        <a href="{{ routes.cart_url }}"><span>3</span><strong>Reach the $500 minimum</strong><p>Combine products and change quantities inside the Order Builder.</p></a>
        <a href="{{ routes.cart_url }}"><span>4</span><strong>Confirm and checkout</strong><p>Free U.S. shipping and applicable sales tax are included in the listed total.</p></a>
      </div>
    </div>

    <div class="globisun-section-head">
      <p class="globisun-eyebrow">Core supply categories</p>
      <h2>Start with the catalog, then customize the product mix.</h2>
    </div>
    <div class="globisun-card-grid globisun-card-grid--three globisun-category-row">
      <a class="globisun-card globisun-card--link" href="/collections/acrylic-paints"><span class="globisun-card__label">Painting</span><h3>Painting Supplies</h3><p>Acrylic paints, brush sets, palettes, and classroom-friendly painting materials.</p></a>
      <a class="globisun-card globisun-card--link" href="/collections/acrylic-markers"><span class="globisun-card__label">Drawing</span><h3>Drawing & Markers</h3><p>Markers, pens, drawing tools, and bulk supplies for daily creative practice.</p></a>
      <a class="globisun-card globisun-card--link" href="/collections/all"><span class="globisun-card__label">All products</span><h3>Complete Catalog</h3><p>Browse current product lines, available variants, and fixed listed prices.</p></a>
    </div>

    <div class="globisun-cta-panel">
      <div>
        <p class="globisun-eyebrow">Start the order</p>
        <h2>Choose products first. Adjust everything before checkout.</h2>
        <p>Use the Order Builder for quantities and notes, or send a short configuration request for a class, studio, event, or resale project.</p>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a class="button button--secondary" href="/collections/all">Browse Products</a>
        <a class="button button--primary" href="{{ routes.cart_url }}">Open Order Builder</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GlobiSun B2B Home",
  "tag": "section",
  "class": "section globisun-section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GlobiSun Art Supply · Fixed-Price Wholesale"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Bulk Art Supplies for Schools, Studios & Creative Programs"},
    {"type": "textarea", "id": "subheading", "label": "Subheading", "default": "Shop live inventory with fixed all-in pricing, free U.S. shipping, flexible quantities, and customer-editable product notes. Minimum order: $500."},
    {"type": "text", "id": "primary_label", "label": "Primary button label", "default": "Browse All Products"},
    {"type": "url", "id": "primary_link", "label": "Primary button link"},
    {"type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Open Order Builder"},
    {"type": "url", "id": "secondary_link", "label": "Secondary button link"},
    {"type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1"}
  ],
  "presets": [{"name": "GlobiSun B2B Home"}]
}
{% endschema %}