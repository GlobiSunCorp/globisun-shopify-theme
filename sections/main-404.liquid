<section class="globisun-404 color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width" style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:80px 20px;">
    <div style="max-width:960px;width:100%;border:1px solid rgba(var(--color-foreground),.12);border-radius:28px;background:rgba(var(--color-background),.96);box-shadow:0 24px 80px rgba(0,0,0,.08);padding:clamp(32px,6vw,72px);">
      <p style="margin:0 0 14px;text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:900;color:rgba(var(--color-foreground),.62);">404 · Page not found</p>
      <h1 style="margin:0;font-size:clamp(42px,7vw,88px);line-height:.98;letter-spacing:-.05em;color:rgb(var(--color-foreground));">This page is not available.</h1>
      <p style="max-width:760px;margin:26px 0 0;font-size:1.8rem;line-height:1.65;color:rgba(var(--color-foreground),.72);">The page may have moved, or the link may no longer be active. Return to the homepage, browse available products, or send a bulk inquiry.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:30px;">
        <a class="button button--primary" href="/">Go to Homepage</a>
        <a class="button button--secondary" href="/#shop-products">Browse Products</a>
        <a class="button button--secondary" href="/#bulk-inquiry">Bulk Inquiry</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}
  ]
}
{% endschema %}
