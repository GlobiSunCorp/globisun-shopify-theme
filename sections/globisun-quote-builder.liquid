<section class="globisun-quote-builder color-{{ section.settings.color_scheme }} gradient" id="bulk-inquiry">
  <style>
    .gqb-wrap{max-width:1200px;margin:0 auto;padding:72px 20px}.gqb-shell{border:1px solid rgba(54,66,71,.14);border-radius:32px;background:linear-gradient(135deg,#f8f6f1 0%,#fff 48%,#f3f7fb 100%);box-shadow:0 24px 80px rgba(24,33,38,.08);overflow:hidden}.gqb-head{display:grid;grid-template-columns:1.05fr .95fr;gap:28px;padding:42px}.gqb-kicker{margin:0 0 12px;text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:900;color:#728084}.gqb-title{margin:0;color:#364247;font-size:clamp(34px,5vw,68px);line-height:.98;letter-spacing:-.045em}.gqb-lead{margin:18px 0 0;max-width:720px;color:#667074;font-size:17px;line-height:1.65}.gqb-hero-card{border-radius:26px;background:#364247;color:#fff;padding:30px;display:grid;align-content:space-between;min-height:240px}.gqb-hero-card strong{font-size:clamp(26px,3vw,42px);line-height:1.05;letter-spacing:-.035em}.gqb-hero-card span{color:rgba(255,255,255,.72);line-height:1.55}.gqb-body{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:28px;padding:0 42px 42px}.gqb-panel{border:1px solid rgba(54,66,71,.13);border-radius:24px;background:rgba(255,255,255,.74);padding:24px}.gqb-panel h3{margin:0 0 16px;color:#364247;font-size:24px;letter-spacing:-.025em}.gqb-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.gqb-option{position:relative;display:block;cursor:pointer}.gqb-option input{position:absolute;opacity:0;pointer-events:none}.gqb-option span{display:block;min-height:98px;border:1px solid rgba(54,66,71,.14);border-radius:18px;background:#fff;padding:16px;color:#364247;transition:.18s ease}.gqb-option b{display:block;font-size:16px;margin-bottom:6px}.gqb-option small{display:block;color:#6f7a7d;line-height:1.35}.gqb-option input:checked + span{border-color:#2f6fbd;background:#eef5ff;box-shadow:0 12px 28px rgba(47,111,189,.14)}.gqb-option input:checked + span:after{content:'✓';position:absolute;right:14px;top:12px;width:24px;height:24px;border-radius:999px;background:#2f6fbd;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900}.gqb-service input:checked + span{border-color:#c94a3a;background:#fff3ef;box-shadow:0 12px 28px rgba(201,74,58,.12)}.gqb-service input:checked + span:after{background:#c94a3a}.gqb-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.gqb-field{display:grid;gap:8px}.gqb-field label{font-size:12px;text-transform:uppercase;letter-spacing:.12em;font-weight:900;color:#6f7a7d}.gqb-field input,.gqb-field select,.gqb-field textarea{width:100%;border:1px solid rgba(54,66,71,.22);border-radius:14px;background:#fff;padding:14px 15px;color:#364247;font:inherit}.gqb-field textarea{min-height:220px;resize:vertical}.gqb-full{grid-column:1/-1}.gqb-summary-box{position:sticky;top:24px}.gqb-summary-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.gqb-summary-title h3{margin:0}.gqb-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;background:#eef5ff;color:#2f6fbd;padding:8px 12px;font-size:12px;font-weight:900}.gqb-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}.gqb-submit{border:0;border-radius:14px;background:#2f6fbd;color:#fff;min-height:56px;padding:0 24px;font-weight:900;letter-spacing:.03em;cursor:pointer;box-shadow:0 14px 32px rgba(47,111,189,.22)}.gqb-copy{border:1px solid rgba(54,66,71,.22);border-radius:14px;background:#fff;color:#364247;min-height:56px;padding:0 22px;font-weight:900;cursor:pointer}.gqb-note{margin:14px 0 0;color:#6f7a7d;font-size:13px;line-height:1.5}.gqb-success{margin:0 0 20px;padding:16px 18px;border-radius:16px;background:#edf8ef;color:#276738;font-weight:800}.gqb-error{margin:0 0 20px;padding:16px 18px;border-radius:16px;background:#fff1f1;color:#8d2d2d;font-weight:800}@media(max-width:900px){.gqb-head,.gqb-body{grid-template-columns:1fr;padding:28px}.gqb-summary-box{position:static}.gqb-options{grid-template-columns:1fr}}@media(max-width:640px){.gqb-wrap{padding:48px 16px}.gqb-form-grid{grid-template-columns:1fr}.gqb-head,.gqb-body{padding:22px}.gqb-title{font-size:40px}.gqb-submit,.gqb-copy{width:100%}}
  </style>

  <div class="gqb-wrap">
    <div class="gqb-shell">
      <div class="gqb-head">
        <div>
          <p class="gqb-kicker">Bulk Quote Builder</p>
          <h2 class="gqb-title">Build your art supply request like a smart inquiry cart.</h2>
          <p class="gqb-lead">Select product categories, custom services, quantity range, delivery ZIP code, and timeline. The form will generate a clear request summary so we can review pricing, sourcing, packaging, and fulfillment options faster.</p>
        </div>
        <div class="gqb-hero-card">
          <span>Designed for schools, studios, workshops, resellers, and creative teams.</span>
          <strong>$500+ bulk sourcing review · product + service options · clean request summary.</strong>
        </div>
      </div>

      <div class="gqb-body">
        {% form 'contact', id: 'GlobiSunQuoteBuilder', class: 'gqb-form' %}
          {% if form.posted_successfully? %}
            <div class="gqb-success">Thank you. Your bulk request was sent successfully.</div>
          {% endif %}
          {% if form.errors %}
            <div class="gqb-error">Please check the required fields and try again.</div>
          {% endif %}

          <div class="gqb-panel">
            <h3>1. Choose product categories</h3>
            <div class="gqb-options" data-gqb-group="Products">
              <label class="gqb-option"><input type="checkbox" value="Drawing & markers"><span><b>Drawing & Markers</b><small>Markers, pens, sketch tools, classroom drawing supplies.</small></span></label>
              <label class="gqb-option"><input type="checkbox" value="Acrylic paints"><span><b>Acrylic Paints</b><small>Bottled paint, color sets, studio and classroom paint supply.</small></span></label>
              <label class="gqb-option"><input type="checkbox" value="Brushes & painting tools"><span><b>Brushes & Tools</b><small>Brush sets, palettes, painting accessories, tool kits.</small></span></label>
              <label class="gqb-option"><input type="checkbox" value="Canvas, paper & surfaces"><span><b>Surfaces & Paper</b><small>Canvas panels, paper, boards, practice surfaces.</small></span></label>
              <label class="gqb-option"><input type="checkbox" value="School / studio kits"><span><b>School & Studio Kits</b><small>Class sets, camp kits, workshop bundles, recurring program packs.</small></span></label>
              <label class="gqb-option"><input type="checkbox" value="Custom / not listed products"><span><b>Custom Sourcing</b><small>Products not listed on the site, alternate brands, substitute options.</small></span></label>
            </div>
          </div>

          <div class="gqb-panel" style="margin-top:18px;">
            <h3>2. Add custom services</h3>
            <div class="gqb-options" data-gqb-group="Services">
              <label class="gqb-option gqb-service"><input type="checkbox" value="Logo printing / custom branding"><span><b>Logo Printing</b><small>Brand logo, school name, event identity, or custom packaging request.</small></span></label>
              <label class="gqb-option gqb-service"><input type="checkbox" value="Private label / packaging review"><span><b>Private Label Review</b><small>Packaging, barcode, simple brand presentation, resale preparation.</small></span></label>
              <label class="gqb-option gqb-service"><input type="checkbox" value="Kit assembly / class pack planning"><span><b>Kit Assembly</b><small>Product bundles for class sessions, camps, workshops, or art programs.</small></span></label>
              <label class="gqb-option gqb-service"><input type="checkbox" value="Color / variant planning"><span><b>Color Planning</b><small>Color count, variants, classroom distribution, substitute colors.</small></span></label>
              <label class="gqb-option gqb-service"><input type="checkbox" value="Supplier substitute options"><span><b>Substitute Options</b><small>Comparable products if an exact item is unavailable or too costly.</small></span></label>
              <label class="gqb-option gqb-service"><input type="checkbox" value="Shipping carton / bulk freight review"><span><b>Shipping Review</b><small>Carton quantity, weight, lead time, and freight practicality review.</small></span></label>
            </div>
          </div>

          <div class="gqb-panel" style="margin-top:18px;">
            <h3>3. Order details</h3>
            <div class="gqb-form-grid">
              <div class="gqb-field"><label for="gqb-company">Company / School / Studio</label><input id="gqb-company" name="contact[Organization]" type="text" placeholder="Organization name"></div>
              <div class="gqb-field"><label for="gqb-buyer-type">Buyer type</label><select id="gqb-buyer-type" name="contact[Buyer type]"><option>School / Education Program</option><option>Art Studio / Workshop</option><option>Retailer / Reseller</option><option>Creative Team / Production</option><option>Other</option></select></div>
              <div class="gqb-field"><label for="gqb-quantity">Estimated quantity</label><input id="gqb-quantity" name="contact[Estimated quantity]" type="text" placeholder="Example: 100 sets / 20 cartons / 500 pcs"></div>
              <div class="gqb-field"><label for="gqb-budget">Target budget</label><select id="gqb-budget" name="contact[Target budget]"><option>$500 - $1,000</option><option>$1,000 - $2,500</option><option>$2,500 - $5,000</option><option>$5,000+</option><option>Not sure yet</option></select></div>
              <div class="gqb-field"><label for="gqb-zip">Delivery ZIP code</label><input id="gqb-zip" name="contact[Delivery ZIP]" type="text" placeholder="ZIP code"></div>
              <div class="gqb-field"><label for="gqb-timeline">Timeline</label><select id="gqb-timeline" name="contact[Timeline]"><option>Flexible / planning stage</option><option>Need within 2-4 weeks</option><option>Need within 1-2 months</option><option>Seasonal / program date</option><option>Not sure yet</option></select></div>
              <div class="gqb-field gqb-full"><label for="gqb-notes">Extra notes</label><textarea id="gqb-notes" name="contact[Extra notes]" placeholder="Tell us colors, product links, logo printing needs, packaging requirements, preferred substitutes, or anything important."></textarea></div>
            </div>
          </div>

          <div class="gqb-panel" style="margin-top:18px;">
            <h3>4. Contact information</h3>
            <div class="gqb-form-grid">
              <div class="gqb-field"><label for="gqb-name">Name</label><input id="gqb-name" name="contact[name]" type="text" placeholder="Your name"></div>
              <div class="gqb-field"><label for="gqb-email">Email *</label><input id="gqb-email" name="contact[email]" type="email" placeholder="you@example.com" required></div>
              <div class="gqb-field"><label for="gqb-phone">Phone</label><input id="gqb-phone" name="contact[phone]" type="tel" placeholder="Optional"></div>
              <div class="gqb-field"><label for="gqb-subject">Subject</label><input id="gqb-subject" name="contact[Subject]" type="text" value="GlobiSun bulk quote request"></div>
            </div>
          </div>
        </div>

        <aside class="gqb-panel gqb-summary-box">
          <div class="gqb-summary-title"><h3>Request summary</h3><span class="gqb-chip">Live summary</span></div>
          <div class="gqb-field">
            <label for="gqb-summary">Generated request sent to GlobiSun</label>
            <textarea id="gqb-summary" name="contact[body]" readonly></textarea>
          </div>
          <div class="gqb-actions">
            <button type="submit" class="gqb-submit">Send Bulk Request</button>
            <button type="button" class="gqb-copy" data-gqb-copy>Copy Summary</button>
          </div>
          <p class="gqb-note">This form sends your selected products, custom services, and request details to GlobiSun for review. For best results, include quantity, ZIP code, timeline, and any logo/packaging requirements.</p>
        </aside>
      {% endform %}
    </div>
  </div>

  <script>
    (() => {
      const section = document.currentScript.closest('.globisun-quote-builder');
      if (!section) return;
      const summary = section.querySelector('#gqb-summary');
      const copyBtn = section.querySelector('[data-gqb-copy]');
      const fields = ['#gqb-company','#gqb-buyer-type','#gqb-quantity','#gqb-budget','#gqb-zip','#gqb-timeline','#gqb-notes','#gqb-name','#gqb-email','#gqb-phone'];
      const getChecked = (group) => Array.from(section.querySelectorAll(`[data-gqb-group="${group}"] input:checked`)).map(i => i.value);
      const val = (sel) => (section.querySelector(sel)?.value || '').trim();
      const update = () => {
        const products = getChecked('Products');
        const services = getChecked('Services');
        const lines = [
          'GlobiSun Bulk Quote Request',
          '----------------------------',
          `Name: ${val('#gqb-name') || 'Not provided'}`,
          `Email: ${val('#gqb-email') || 'Not provided'}`,
          `Phone: ${val('#gqb-phone') || 'Not provided'}`,
          `Organization: ${val('#gqb-company') || 'Not provided'}`,
          `Buyer type: ${val('#gqb-buyer-type') || 'Not provided'}`,
          '',
          `Product categories: ${products.length ? products.join(', ') : 'Not selected yet'}`,
          `Custom services: ${services.length ? services.join(', ') : 'Not selected yet'}`,
          '',
          `Estimated quantity: ${val('#gqb-quantity') || 'Not provided'}`,
          `Target budget: ${val('#gqb-budget') || 'Not provided'}`,
          `Delivery ZIP: ${val('#gqb-zip') || 'Not provided'}`,
          `Timeline: ${val('#gqb-timeline') || 'Not provided'}`,
          '',
          'Extra notes:',
          val('#gqb-notes') || 'No extra notes yet.',
          '',
          'Requested review: pricing, sourcing feasibility, packaging/carton options, substitutes, and bulk fulfillment path.'
        ];
        summary.value = lines.join('\n');
      };
      section.querySelectorAll('input,select,textarea').forEach(el => el.addEventListener('input', update));
      section.querySelectorAll('input[type="checkbox"]').forEach(el => el.addEventListener('change', update));
      copyBtn?.addEventListener('click', async () => {
        update();
        try { await navigator.clipboard.writeText(summary.value); copyBtn.textContent = 'Copied ✓'; setTimeout(() => copyBtn.textContent = 'Copy Summary', 1600); }
        catch(e){ summary.focus(); summary.select(); document.execCommand('copy'); }
      });
      update();
    })();
  </script>
</section>

{% schema %}
{
  "name": "GlobiSun quote builder",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}
  ],
  "presets": [{"name":"GlobiSun quote builder"}]
}
{% endschema %}
